// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/javascript-node
{
	"name": "Node.js",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",

	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": { 
		"ghcr.io/devcontainers-extra/features/mise:1": {},
        "ghcr.io/devcontainers-extra/features/typst:1": { "version": "0.14.2" },
        "ghcr.io/prulloac/devcontainer-features/latex:1": {
            "packages": "biber,biblatex,enumitem,fontawesome,fontspec,ifmtarg,lualatex-math,needspace,parskip,ragged2e,setspace,soul,sourcesanspro,tcolorbox,tikzfill,unicode-math,wrapfig,xcolor,xifthen,xkeyval"
        }
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"hverlin.mise-vscode",
				"tamasfe.even-better-toml",
				"lfs.vscode-emacs-friendly",
				"wholroyd.jinja",
				"ms-python.python",
				"anthropic.claude-code"
			]
		}
	},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	"forwardPorts": [8008,8009],
    "appPort": [8008,8009],
    "updateRemoteUserUID": false,

	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": "sudo mkdir -p /home/node/.npm /home/node/.cache /home/node/.local /home/node/.local/bin && sudo chown -R node:node /home/node/.npm /home/node/.cache /home/node/.local && mise trust . && mise install && mise x -- mise run bootstrap && (cd /home/node/.local/bin; curl --proto '=https' --tlsv1.2 -fsSL https://drop-sh.fullyjustified.net | sh)",
	// Use 'postStartCommand' to run commands after the container is started.
    "postStartCommand": "grep -q 'mise activate' ~/.bashrc || echo 'eval \"$(mise activate bash)\"' >> ~/.bashrc",

    // Mount caches from the host to speed up container rebuild
    "mounts": [
        "source=vita-npm-cache,target=/home/node/.npm,type=volume",
        "source=vita-uv-cache,target=/home/node/.cache/uv,type=volume",
        "source=vita-mise,target=/home/node/.local/share/mise,type=volume",
        "source=${localEnv:HOME}/.local/share/fonts,target=/home/node/.local/share/fonts,type=bind,consistency=cached",
    ]

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
